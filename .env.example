# Neon PostgreSQL Connection String (Transaction Pooler recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth Secret Key (not currently mounted anywhere)
BETTER_AUTH_SECRET="replace-with-a-long-random-value"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side pepper for password/PIN hashing. REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_PEPPER="replace-with-a-long-random-value"

# Optional Geolocation / Tile Services
NEXT_PUBLIC_MAPBOX_TOKEN=""
